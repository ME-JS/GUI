local NotificationLibrary = {}

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local THEMES = {
    Success = {
        color = Color3.fromRGB(35, 240, 110),
        icon = "rbxassetid://6023426926",
        title = "Success",
    },
    Info = {
        color = Color3.fromRGB(220, 220, 220),
        icon = "rbxassetid://7072717857",
        title = "Information",
    },
    Warning = {
        color = Color3.fromRGB(240, 175, 45),
        icon = "rbxassetid://7072980286",
        title = "Warning",
    },
    Error = {
        color = Color3.fromRGB(255, 70, 73),
        icon = "rbxassetid://7072725342",
        title = "Error",
    },
}

local screenGui
local listFrame
local active = false
local nextLayoutOrder = 0

local function create(className, properties, parent)
    local instance = Instance.new(className)
    for key, value in pairs(properties) do
        instance[key] = value
    end
    instance.Parent = parent
    return instance
end

local function makeNotificationGui()
    local player = Players.LocalPlayer
    assert(player, "NotificationLibrary must be loaded from a LocalScript")

    local playerGui = player:WaitForChild("PlayerGui")
    local existing = playerGui:FindFirstChild("NotificationLibraryGui")
    if existing then
        existing:Destroy()
    end

    screenGui = create("ScreenGui", {
        Name = "NotificationLibraryGui",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 50,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, playerGui)

    listFrame = create("Frame", {
        Name = "list",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.91076, 0, 0.52171, 0),
        Size = UDim2.new(0.17766, 0, 0.86927, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, screenGui)

    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Top,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 5),
    }, listFrame)
end

local function createCard(mode, text, duration)
    local theme = THEMES[mode]
    nextLayoutOrder += 1

    local card = create("Frame", {
        Name = mode,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.11, 0),
        Size = UDim2.new(0, 0, 0.087, 0),
        BackgroundColor3 = Color3.fromRGB(31, 31, 31),
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        Visible = true,
        LayoutOrder = nextLayoutOrder,
    }, listFrame)

    create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(31, 31, 31)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(39, 39, 39)),
        }),
        Rotation = 25,
    }, card)

    local shadow = create("ImageLabel", {
        Name = "background_shadow",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1.12801, 0, 1.86364, 0),
        BackgroundTransparency = 1,
        Image = "rbxassetid://3523728077",
        ImageColor3 = Color3.fromRGB(24, 24, 24),
        ImageTransparency = 0.7,
        ScaleType = Enum.ScaleType.Stretch,
        ZIndex = 0,
    }, card)
    create("UIAspectRatioConstraint", {
        AspectRatio = 2.6686997,
        DominantAxis = Enum.DominantAxis.Width,
        AspectType = Enum.AspectType.FitWithinMaxSize,
    }, shadow)

    local icon = create("ImageLabel", {
        Name = "icon",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.08956, 0, 0.4853, 0),
        Size = UDim2.new(0.09, 0, 0.485, 0),
        BackgroundTransparency = 1,
        Image = theme.icon,
        ImageColor3 = theme.color,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = 2,
    }, card)
    create("UIAspectRatioConstraint", {
        AspectRatio = 1.008,
        DominantAxis = Enum.DominantAxis.Width,
        AspectType = Enum.AspectType.FitWithinMaxSize,
    }, icon)

    create("TextLabel", {
        Name = "Header",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.592, 0, 0.494, 0),
        Size = UDim2.new(0.789, 0, 0.648, 0),
        BackgroundTransparency = 1,
        Text = tostring(text),
        TextColor3 = theme.color,
        TextTransparency = 0,
        TextStrokeTransparency = 1,
        TextSize = 14,
        TextScaled = true,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Font = Enum.Font.GothamBold,
        RichText = false,
        LineHeight = 1,
        ZIndex = 3,
    }, card)
    local label = card.Header
    create("UITextSizeConstraint", {
        MinTextSize = 1,
        MaxTextSize = 14,
    }, label)

    local filler = create("Frame", {
        Name = "Filler",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = theme.color,
        BorderSizePixel = 0,
        ZIndex = 4,
    }, card)

    local bar = create("Frame", {
        Name = "bar",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 1, 0),
        Size = UDim2.new(0.01, 0, 0.05, 0),
        BackgroundColor3 = theme.color,
        BorderSizePixel = 0,
        ZIndex = 5,
    }, card)

    return card, filler, bar
end

function NotificationLibrary:Load()
    if active and screenGui and screenGui.Parent then
        return self
    end
    makeNotificationGui()
    active = true
    return self
end

function NotificationLibrary:SendNotification(mode, text, duration)
    if type(mode) ~= "string" or not THEMES[mode] then
        warn("NotificationLibrary: unknown mode. Use Success, Info, Warning, or Error.")
        return
    end
    if type(text) ~= "string" then
        text = tostring(text)
    end
    if type(duration) ~= "number" or duration ~= duration then
        duration = 3
    end
    duration = math.clamp(duration, 0.1, 120)

    if not active or not screenGui or not screenGui.Parent then
        self:Load()
    end

    task.spawn(function()
        local card
        local ok, err = pcall(function()
            local filler
            local bar
            card, filler, bar = createCard(mode, text, duration)
            local expand = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            local fillerTween = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            local close = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

            TweenService:Create(card, expand, {
                Size = UDim2.new(1, 0, 0.087, 0),
            }):Play()
            task.wait(0.2)

            TweenService:Create(filler, fillerTween, {
                Size = UDim2.new(0.011, 0, 1, 0),
            }):Play()

            TweenService:Create(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
                Size = UDim2.new(1, 0, 0.05, 0),
            }):Play()
            task.wait(duration)

            if not card.Parent then
                return
            end

            TweenService:Create(filler, expand, {
                Size = UDim2.new(1, 0, 1, 0),
            }):Play()
            task.wait(0.25)

            if card.Parent then
                TweenService:Create(card, close, {
                    Size = UDim2.new(0, 0, 0.087, 0),
                }):Play()
                task.wait(0.2)
            end
            if card.Parent then
                card:Destroy()
            end
        end)
        if not ok then
            if card and card.Parent then
                card:Destroy()
            end
            warn("NotificationLibrary error: " .. tostring(err))
        end
    end)
end

function NotificationLibrary:Destroy()
    active = false
    if screenGui then
        screenGui:Destroy()
        screenGui = nil
        listFrame = nil
    end
end

return NotificationLibrary
