local Library = {}
Library.__index = Library

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local Theme = {
    Background = Color3.fromRGB(10, 10, 10),
    TitleBar = Color3.fromRGB(12, 12, 12),
    TabBar = Color3.fromRGB(16, 16, 16),
    TabIdle = Color3.fromRGB(30, 30, 30),
    TabActive = Color3.fromRGB(60, 60, 80),
    Text = Color3.fromRGB(255, 255, 255),
    Muted = Color3.fromRGB(180, 180, 180),
    Element = Color3.fromRGB(70, 70, 70),
    On = Color3.fromRGB(40, 160, 40),
    Off = Color3.fromRGB(70, 70, 70),
    Red = Color3.fromRGB(180, 40, 40),
    Blue = Color3.fromRGB(40, 90, 150),
    Purple = Color3.fromRGB(80, 50, 140),
    Label = Color3.fromRGB(255, 200, 100),
}

local function create(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function corner(parent, radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius or 5) }, parent)
end

local function getUIParent()
    if gethui then return gethui() end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    return localPlayer:WaitForChild("PlayerGui")
end

function Library.new()
    local self = setmetatable({}, Library)
    self.Windows = {}
    self.Theme = Theme
    return self
end

function Library:CreateWindow(config)
    config = config or {}
    local theme = self.Theme
    local parent = config.Parent or getUIParent()
    local name = config.Name or "LibraryGUI"

    if parent:FindFirstChild(name) then
        parent:FindFirstChild(name):Destroy()
    end

    local screenGui = create("ScreenGui", {
        Name = name,
        ResetOnSpawn = false,
    }, parent)

    local mainFrame = create("Frame", {
        Size = config.Size or UDim2.new(0, 210, 0, 260),
        Position = config.Position or UDim2.new(1, -230, 0, 20),
        BackgroundColor3 = theme.Background,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Active = true,
        Draggable = true,
        ClipsDescendants = true,
    }, screenGui)
    corner(mainFrame, 8)

    local titleBar = create("Frame", {
        Size = UDim2.new(1, 0, 0, 22),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = theme.TitleBar,
        BorderSizePixel = 0,
    }, mainFrame)
    corner(titleBar, 8)

    local title = create("TextLabel", {
        Size = UDim2.new(1, -45, 1, 0),
        Position = UDim2.new(0, 4, 0, 0),
        BackgroundTransparency = 1,
        Text = config.Title or "Library",
        TextColor3 = theme.Text,
        Font = Enum.Font.SourceSansBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, titleBar)

    local minimizeBtn = create("TextButton", {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(1, -42, 0, 1),
        BackgroundColor3 = Color3.fromRGB(50, 50, 50),
        Text = "-",
        TextColor3 = theme.Text,
    }, titleBar)
    corner(minimizeBtn, 5)

    local closeBtn = create("TextButton", {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(1, -21, 0, 1),
        BackgroundColor3 = theme.Red,
        Text = "X",
        TextColor3 = theme.Text,
    }, titleBar)
    corner(closeBtn, 5)

    local tabBar = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 21),
        Position = UDim2.new(0, 0, 0, 21),
        BackgroundColor3 = theme.TabBar,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Color3.fromRGB(110, 110, 110),
        ScrollBarImageTransparency = 0.4,
        ScrollingDirection = Enum.ScrollingDirection.X,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.X,
        ElasticBehavior = Enum.ElasticBehavior.Never,
    }, mainFrame)

    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 0),
    }, tabBar)

    local smallIcon = create("TextButton", {
        Size = UDim2.new(0, 32, 0, 32),
        Position = UDim2.new(1, -45, 0, 20),
        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
        BackgroundTransparency = 0.2,
        Text = "Gun",
        TextColor3 = theme.Text,
        Font = Enum.Font.SourceSansBold,
        TextSize = 10,
        BorderSizePixel = 0,
        Active = true,
        Draggable = true,
        Visible = false,
    }, screenGui)
    corner(smallIcon, 6)

    minimizeBtn.MouseButton1Click:Connect(function()
        mainFrame.Visible = false
        smallIcon.Visible = true
    end)

    smallIcon.MouseButton1Click:Connect(function()
        mainFrame.Visible = true
        smallIcon.Visible = false
    end)

    closeBtn.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)

    local window = {
        ScreenGui = screenGui,
        Main = mainFrame,
        TabBar = tabBar,
        Tabs = {},
        CurrentTab = nil,
        Theme = theme,
    }

    function window:AddTab(tabName)
        local index = #self.Tabs + 1
        local TAB_WIDTH = 70

        local btn = create("TextButton", {
            Size = UDim2.new(0, TAB_WIDTH, 1, 0),
            BackgroundColor3 = theme.TabIdle,
            Text = tostring(tabName),
            TextColor3 = theme.Muted,
            Font = Enum.Font.SourceSansBold,
            TextSize = 11,
            BorderSizePixel = 0,
            LayoutOrder = index,
        }, self.TabBar)

        local page = create("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, -42),
            Position = UDim2.new(0, 0, 0, 42),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Color3.fromRGB(110, 110, 110),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
        }, self.Main)

        local layout = create("UIListLayout", {
            Padding = UDim.new(0, 2),
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, page)

        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
        end)

        btn.MouseButton1Click:Connect(function()
            for _, t in ipairs(self.Tabs) do
                t.Page.Visible = false
                t.Button.BackgroundColor3 = theme.TabIdle
                t.Button.TextColor3 = theme.Muted
            end
            page.Visible = true
            btn.BackgroundColor3 = theme.TabActive
            btn.TextColor3 = theme.Text
            self.CurrentTab = tab

            local targetX = (index - 1) * TAB_WIDTH
            local maxScroll = math.max(0, #self.Tabs * TAB_WIDTH - self.TabBar.AbsoluteSize.X)
            self.TabBar.CanvasPosition = Vector2.new(math.clamp(targetX, 0, maxScroll), 0)
        end)

        local tab = {
            Window = self,
            Name = tostring(tabName),
            Button = btn,
            Page = page,
            Layout = layout,
            NextOrder = 1,
        }

        local function newRow(height)
            local f = create("Frame", {
                Size = UDim2.new(1, -6, 0, height or 22),
                BackgroundTransparency = 1,
                LayoutOrder = tab.NextOrder,
            }, page)
            tab.NextOrder = tab.NextOrder + 1
            return f
        end

        function tab:AddLabel(text, color, textSize, height)
            local row = newRow(height or 16)
            return create("TextLabel", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = tostring(text),
                TextColor3 = color or theme.Label,
                Font = Enum.Font.SourceSans,
                TextSize = textSize or 10,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, row)
        end

        function tab:AddToggle(id, config)
            config = config or {}
            local row = newRow(22)
            local btn = create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundColor3 = config.Default and theme.On or (config.OffColor or theme.Off),
                Text = (config.Text or id) .. ": " .. (config.Default and "开启" or "关闭"),
                TextColor3 = theme.Text,
                Font = Enum.Font.SourceSansBold,
                TextSize = 11,
            }, row)
            corner(btn, 4)

            local control = { Value = config.Default == true, Callback = config.Callback }
            local onColor = config.OnColor or theme.On
            local offColor = config.OffColor or theme.Off

            local function set(value, fire)
                control.Value = value == true
                btn.BackgroundColor3 = control.Value and onColor or offColor
                btn.Text = (config.Text or id) .. ": " .. (control.Value and "开启" or "关闭")
                if fire and control.Callback then control.Callback(control.Value) end
            end

            btn.MouseButton1Click:Connect(function()
                set(not control.Value, true)
            end)

            function control:SetValue(v) set(v, true) end
            function control:OnChanged(cb) self.Callback = cb; return self end
            set(control.Value, false)
            return control
        end

        function tab:AddButton(id, config)
            config = config or {}
            local row = newRow(22)
            local btn = create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundColor3 = config.Color or theme.Element,
                Text = config.Text or id,
                TextColor3 = theme.Text,
                Font = Enum.Font.SourceSansBold,
                TextSize = 11,
            }, row)
            corner(btn, 4)
            local control = { Callback = config.Callback }
            btn.MouseButton1Click:Connect(function()
                if config.Func then config.Func() end
                if control.Callback then control.Callback() end
            end)
            function control:OnClick(cb) self.Callback = cb; return self end
            return control
        end

        function tab:AddInput(id, config)
            config = config or {}
            local row = newRow(22)
            local box = create("TextBox", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundColor3 = Color3.fromRGB(40, 40, 40),
                Text = config.Default or "",
                PlaceholderText = config.Placeholder or "",
                TextColor3 = theme.Text,
                PlaceholderColor3 = Color3.fromRGB(130, 130, 130),
                Font = Enum.Font.SourceSans,
                TextSize = 11,
                ClearTextOnFocus = false,
            }, row)
            corner(box, 4)
            local control = { Object = box, Callback = config.Callback }
            box.FocusLost:Connect(function(enter)
                if config.Callback then config.Callback(box.Text, enter) end
                if control.Callback then control.Callback(box.Text, enter) end
            end)
            function control:GetValue() return box.Text end
            function control:SetValue(v) box.Text = tostring(v or "") end
            function control:OnChanged(cb) self.Callback = cb; return self end
            return control
        end

        function tab:AddDropdown(id, config)
            config = config or {}
            local values = config.Values or {}
            local row = newRow(44)

            local btn = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 22),
                BackgroundColor3 = config.Color or theme.Blue,
                Text = tostring(config.Default or values[1] or "选择"),
                TextColor3 = theme.Text,
                Font = Enum.Font.SourceSansBold,
                TextSize = 11,
            }, row)
            corner(btn, 4)

            local control = { Value = config.Default or values[1] }
            local menu = nil

            local function choose(v)
                control.Value = v
                btn.Text = tostring(v)
                if menu then menu:Destroy(); menu = nil end
                if config.Callback then config.Callback(v) end
                if control.Callback then control.Callback(v) end
            end

            btn.MouseButton1Click:Connect(function()
                if menu then menu:Destroy(); menu = nil; return end
                local container = self.Main
                menu = create("ScrollingFrame", {
                    Size = UDim2.new(1, -12, 0, math.min(#values, 4) * 22),
                    Position = UDim2.new(0, 6, 0, 200),
                    BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                    BorderSizePixel = 0,
                    CanvasSize = UDim2.new(0, 0, 0, #values * 22),
                    ScrollBarThickness = 3,
                    ZIndex = 20,
                }, container)
                corner(menu, 4)

                for i, v in ipairs(values) do
                    local opt = create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 22),
                        Position = UDim2.new(0, 0, 0, (i - 1) * 22),
                        BackgroundColor3 = Color3.fromRGB(40, 40, 40),
                        Text = tostring(v),
                        TextColor3 = theme.Text,
                        Font = Enum.Font.SourceSans,
                        TextSize = 11,
                        ZIndex = 21,
                    }, menu)
                    opt.MouseButton1Click:Connect(function() choose(v) end)
                end
            end)

            function control:SetValue(v) choose(v) end
            function control:OnChanged(cb) self.Callback = cb; return self end
            return control
        end

        table.insert(self.Tabs, tab)
        if #self.Tabs == 1 then
            page.Visible = true
            btn.BackgroundColor3 = theme.TabActive
            btn.TextColor3 = theme.Text
            self.CurrentTab = tab
        end

        return tab
    end

    function window:Destroy()
        screenGui:Destroy()
    end

    table.insert(self.Windows, window)
    return window
end

return Library
