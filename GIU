local LibraryName = "Notification Library"
local NotificationLibrary = {}

local TweenService = game:GetService("TweenService")
local CoreGui = cloneref(game:GetService("CoreGui"))

local library
local templateFolder
local canvas

function NotificationLibrary:Load()
    local existing = CoreGui:FindFirstChild(LibraryName)

    if existing then
        library = existing
    else
        library = game:GetObjects("rbxassetid://15133757123")[1]
        library.Name = LibraryName
        library.Parent = CoreGui
    end

    templateFolder = library:WaitForChild("Templates")
    canvas = library:WaitForChild("list")
end

function NotificationLibrary:SendNotification(Mode, Text, Duration)
    Duration = math.max(tonumber(Duration) or 3, 0.1)

    if not library or not library.Parent then
        self:Load()
    else
        templateFolder = library:WaitForChild("Templates")
        canvas = library:WaitForChild("list")
    end

    local template = templateFolder:FindFirstChild(Mode)

    if not template then
        warn("Invalid theme applied:", tostring(Mode))
        return
    end

    task.spawn(function()
        local success, err = pcall(function()
            local notification = template:Clone()
            local filler = notification:WaitForChild("Filler")
            local bar = notification:WaitForChild("bar")
            local header = notification:WaitForChild("Header")

            local originalSize = notification.Size
            local originalPosition = notification.Position

            header.Text = tostring(Text or "")
            notification.Visible = true
            notification.Parent = canvas
            notification.ClipsDescendants = true

            notification.Size = UDim2.new(
                0, 0,
                originalSize.Y.Scale,
                originalSize.Y.Offset
            )

            filler.AnchorPoint = Vector2.new(0, 0)
            filler.Position = UDim2.fromScale(0, 0)
            filler.Size = UDim2.fromScale(0, 1)
            filler.Visible = true

            local maxZIndex = notification.ZIndex

            for _, object in ipairs(notification:GetDescendants()) do
                if object:IsA("GuiObject") and object ~= filler then
                    maxZIndex = math.max(maxZIndex, object.ZIndex)
                end
            end

            filler.ZIndex = maxZIndex + 1

            local enterTween = TweenService:Create(
                notification,
                TweenInfo.new(
                    0.2,
                    Enum.EasingStyle.Quad,
                    Enum.EasingDirection.Out
                ),
                {Size = originalSize}
            )

            enterTween:Play()
            enterTween.Completed:Wait()

            if not notification.Parent then
                return
            end

            local barTween = TweenService:Create(
                bar,
                TweenInfo.new(Duration, Enum.EasingStyle.Linear),
                {
                    Size = UDim2.new(
                        1, 0,
                        bar.Size.Y.Scale,
                        bar.Size.Y.Offset
                    )
                }
            )

            barTween:Play()
            task.wait(Duration)

            if not notification.Parent then
                return
            end

            header.Visible = false
            bar.Visible = false

            for _, object in ipairs(notification:GetDescendants()) do
                if object:IsA("TextLabel")
                    or object:IsA("TextButton")
                    or object:IsA("TextBox") then
                    object.Visible = false
                end
            end

            filler.Visible = true
            filler.Position = UDim2.fromScale(0, 0)
            filler.Size = UDim2.fromScale(0, 1)

            local fillTween = TweenService:Create(
                filler,
                TweenInfo.new(
                    0.45,
                    Enum.EasingStyle.Quad,
                    Enum.EasingDirection.InOut
                ),
                {Size = UDim2.fromScale(1, 1)}
            )

            fillTween:Play()
            fillTween.Completed:Wait()

            if not notification.Parent then
                return
            end

            local exitTween = TweenService:Create(
                notification,
                TweenInfo.new(
                    0.45,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.In
                ),
                {
                    Position = UDim2.new(
                        originalPosition.X.Scale + 1,
                        originalPosition.X.Offset + 400,
                        originalPosition.Y.Scale,
                        originalPosition.Y.Offset
                    )
                }
            )

            exitTween:Play()
            exitTween.Completed:Wait()

            if notification.Parent then
                notification:Destroy()
            end
        end)

        if not success then
            warn("Notification animation error:", err)
        end
    end)
end

return NotificationLibrary
